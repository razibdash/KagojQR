# Copy to .env (git-ignored) and fill in. Pass to Flutter with:
#   flutter run --dart-define-from-file=.env
# Everything in this file is compiled INTO the app. Only public values belong here.
# NEVER put the service-role key or the Google client SECRET here.
# (The Google secret goes only in the Supabase dashboard: Auth > Providers > Google.)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VIEWER_BASE_URL=https://kagojqr.app/v
